{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentshield-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  "vars": {
    "NETWORK": "base-sepolia",
    "PAY_TO_ADDRESS": "0xCeb2c47f8B926806BbaDA35cF0d4C0014132e2BA"
  },

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "aa637fded759496e863d02a1a73303ba",
      "preview_id": "aa637fded759496e863d02a1a73303ba"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "agentshield"
      }
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentshield-db",
      "database_id": "29e211d5-7e19-46eb-97f4-e76dc864fb77"
    }
  ]
}
